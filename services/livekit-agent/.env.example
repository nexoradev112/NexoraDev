LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
APP_URL=https://your-app.example.com
# For docker-compose private networking only. Private HTTP is accepted only
# when the complete origin matches this explicit allowlist.
ALLOW_PRIVATE_APP_URL=false
PRIVATE_APP_ORIGINS=http://api:8000
CALL_WORKER_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
# A distinct base64url-encoded 32-byte AES key shared only by API + voice worker.
# Do not reuse the credential-vault master key.
WORKER_CONFIG_KEY=replace-with-base64url-encoded-32-byte-key
REQUIRE_PROVIDER_ENVELOPE=true
# Used only by dispatcher.py. Create a revocable operator key in the workspace admin.
WORKSPACE_API_KEY=
DISPATCH_POLL_SECONDS=1
# Keep this file server-side. Never use these values in browser code or commit them.
# LLM/STT/TTS credentials are resolved per licensed workspace by the control
# plane. They are intentionally not read from worker environment variables.
PLATFORM_MAX_CALL_SECONDS=3600
