# syntax=docker/dockerfile:1.7
FROM ghcr.io/astral-sh/uv:0.8.22 AS uv

FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PATH=/app/backend/.venv/bin:$PATH

COPY --from=uv /uv /uvx /bin/

WORKDIR /app/backend

RUN groupadd --gid 10001 nexora \
    && useradd --uid 10001 --gid nexora --create-home --home-dir /home/nexora nexora

COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY backend/app ./app

COPY deploy/api-entrypoint.sh /usr/local/bin/api-entrypoint
COPY deploy/migrate-with-lock.py /usr/local/lib/nexora/migrate-with-lock.py

RUN chmod 0555 /usr/local/bin/api-entrypoint \
    && mkdir -p /var/lib/nexora/files /usr/local/lib/nexora \
    && chown -R nexora:nexora /app /var/lib/nexora /home/nexora /usr/local/lib/nexora

USER nexora

EXPOSE 8000

HEALTHCHECK --interval=20s --timeout=5s --start-period=30s --retries=5 \
  CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/ready', timeout=3).read()"]

ENTRYPOINT ["api-entrypoint"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "*"]
