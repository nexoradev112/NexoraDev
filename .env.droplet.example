# Generate the real .env with:
#   sudo ./scripts/init-droplet.sh app.example.com voice.example.com /var/lib/nexora
# Never put secrets in NEXT_PUBLIC_* or VITE_* variables.

COMPOSE_PROJECT_NAME=nexora

DOMAIN=app.example.com
LIVEKIT_DOMAIN=voice.example.com
LIVEKIT_PUBLIC_URL=wss://voice.example.com
MAX_UPLOAD_SIZE=26m

APP_UID=__APP_UID__
APP_GID=__APP_GID__
POSTGRES_UID=70
POSTGRES_GID=70
FILES_DIR=__DATA_ROOT__/files
VOICE_SPOOL_DIR=__DATA_ROOT__/voice-spool
POSTGRES_DATA_DIR=__DATA_ROOT__/postgres

POSTGRES_DB=nexora
POSTGRES_OWNER_USER=nexora_owner
POSTGRES_OWNER_PASSWORD=__POSTGRES_OWNER_PASSWORD__
APP_DB_USER=nexora_app
APP_DB_PASSWORD=__APP_DB_PASSWORD__
DATABASE_URL=postgresql+psycopg://nexora_app:__APP_DB_PASSWORD__@db:5432/nexora

ENVIRONMENT=production
PUBLIC_BASE_URL=https://app.example.com
ALLOWED_ORIGINS=https://app.example.com
SESSION_COOKIE_NAME=__Host-nexora_session
SESSION_TTL_HOURS=168
SESSION_IDLE_HOURS=24
SESSION_COOKIE_SECURE=true
ALLOW_PUBLIC_TENANT_REGISTRATION=false
MAX_UPLOAD_BYTES=26214400

# Independent keys: BYOK vault (standard base64), worker envelope (base64url),
# worker bearer token, and raw Ed25519 key material (standard base64).
CREDENTIAL_MASTER_KEY=__CREDENTIAL_MASTER_KEY__
CREDENTIAL_KEY_VERSION=1
PHONE_HASH_KEY=__PHONE_HASH_KEY__
WORKER_CONFIG_KEY=__WORKER_CONFIG_KEY__
CALL_WORKER_TOKEN=__CALL_WORKER_TOKEN__
LICENSE_SIGNING_PRIVATE_KEY=__LICENSE_SIGNING_PRIVATE_KEY__
LICENSE_SIGNING_PUBLIC_KEY=__LICENSE_SIGNING_PUBLIC_KEY__
RUN_MIGRATIONS=true

# Self-hosted LiveKit starts in the default Compose project.
REDIS_PASSWORD=__REDIS_PASSWORD__
LIVEKIT_API_KEY=__LIVEKIT_API_KEY__
LIVEKIT_API_SECRET=__LIVEKIT_API_SECRET__
LIVEKIT_SERVER_IMAGE=livekit/livekit-server:v1.13.6
LIVEKIT_RTC_PORT_START=50000
LIVEKIT_RTC_PORT_END=50100
PLATFORM_MAX_CALL_SECONDS=3600

# Optional LiveKit Cloud override. Use deploy/compose.livekit-cloud.yml only
# after configuring all three values.
LIVEKIT_CLOUD_URL=
LIVEKIT_CLOUD_API_KEY=
LIVEKIT_CLOUD_API_SECRET=

# Platform credentials are used only when the signed license explicitly maps
# that provider kind to platform mode. BYOK never falls back to these values.
OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=

# Optional server-side telephony documents. Use compact JSON on one line.
TWILIO_CREDENTIALS_JSON=
VONAGE_CREDENTIALS_JSON=
VOBIZ_CREDENTIALS_JSON=
CONVOX_CREDENTIALS_JSON=
TELNYX_CREDENTIALS_JSON=
CLOUDONIX_CREDENTIALS_JSON=
ASTERISK_CREDENTIALS_JSON=

# Phase-two dispatcher. Generate a revocable workspace operator key first.
WORKSPACE_API_KEY=
DISPATCH_POLL_SECONDS=1
